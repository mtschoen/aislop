# Normalize line endings
* text=auto eol=lf

# Explicitly declare text files
*.ts text
*.js text
*.mjs text
*.json text
*.yml text
*.yaml text
*.md text
*.css text
*.html text

# Shell scripts must use LF so their shebang works on every platform.
*.sh text eol=lf

# Batch files must use CRLF because cmd.exe can mis-parse labels, goto targets,
# and multi-line blocks with LF endings.
*.bat text eol=crlf
*.cmd text eol=crlf

# Declare binary files
*.png binary
*.jpg binary
*.gif binary
*.ico binary
*.tgz binary
*.wasm binary

# Linguist overrides - keep generated files out of stats/diffs
dist/** linguist-generated
pnpm-lock.yaml linguist-generated
